# Notewell settings (all optional). Copy to .env. Defaults run fully offline with synthetic data.

# ---- LLM: fake (offline rule-based scribe) | openrouter (free models) | openai_compatible (any endpoint, paid opt-in)
NOTEWELL_LLM_PROVIDER=fake
# NOTEWELL_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# NOTEWELL_LLM_FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free
# OPENROUTER_API_KEY=
# NOTEWELL_LLM_REASONING_EFFORT=none      # disables hidden reasoning on free reasoning models
# NOTEWELL_REQUIRE_FREE_MODELS=true       # refuse non-:free ids, :online variants, plugins, paid served models
# NOTEWELL_ALLOW_PAID_MODELS=false        # explicit opt-in for paid OpenRouter ids and openai_compatible
# NOTEWELL_LLM_BASE_URL=                   # openai_compatible: a BAA-covered gateway in production
# NOTEWELL_LLM_API_KEY=
# NOTEWELL_LLM_MAX_CALLS=800              # hard call budget (ledger: results/calls.jsonl)

# ---- PHI
# NOTEWELL_BLOCK_ON_PHI=true              # fail closed if an identifier survives masking

# ---- speech (needs `uv sync --extra speech` and `notewell models download`)
# NOTEWELL_STT_PROVIDER=whisper
# NOTEWELL_STT_MODEL=small.en
# NOTEWELL_STT_THREADS=4

# ---- storage, retention, access
# NOTEWELL_DATA_DIR=var
# NOTEWELL_DATA_KEY=                       # base64 AES-256 key; empty = generated var/data.key (demo only)
# NOTEWELL_RETENTION_DAYS=30
# NOTEWELL_AUTH_TOKENS=clinician:Dr. Rivera:change-me,viewer:Front Desk:change-me-too

# ---- FHIR: the built-in mock (default) or a HAPI FHIR server
# NOTEWELL_FHIR_BASE_URL=http://localhost:8080/fhir
